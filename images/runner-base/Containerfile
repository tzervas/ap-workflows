# Fleet runner base image.
#
# WHY THIS EXISTS
# The self-hosted runners are rootless podman with `no_new_privs` set, so a job
# step can never escalate:
#
#     sudo: The "no new privileges" flag is set, which prevents sudo from
#     running as root.
#
# That makes `sudo apt-get install <tool>` unfixable inside a workflow — not
# awkward, impossible. Every tool a job needs must therefore already be in the
# image. Anything installed per-job is a workaround waiting to break.
#
# LAYERING
# This is the FLEET-LEVEL base: the tools every repo's CI reaches for. Project-
# and repo-level images build FROM it and add only what is specific to them,
# via the reusable workflow's `base-image` input:
#
#     jobs:
#       image:
#         uses: tzervas/ap-workflows/.github/workflows/reusable-image-build.yml@v0.1
#         with:
#           base-image: ghcr.io/tzervas/ap-workflows/runner-base:latest
#
# Keep this layer boring and slow-moving. A tool that only one repo needs
# belongs in that repo's own image, not here — this one is rebuilt rarely and
# every repo inherits its size.
#
# ── sec-20260728-high ─────────────────────────────────────────────────────────
# Upstream gh 2.96.0 / trivy 0.72.0 / sops 3.13.3 are already latest stable, but
# the release binaries still embed fixable HIGH go-module CVEs (grpc, oras-go,
# stdlib). This image multi-stage rebuilds gh + trivy from those release tags
# with go 1.26.5 and forced module bumps; only the resulting static binaries
# land in the final image. sops release binary is clean and stays tarball-based.
# Residual unfixed: oras-go CVE-2026-50163 (no FixedVersion upstream yet).

# Global ARGs for FROM lines (must sit above every FROM).
# GO_IMAGE is build-only; BASE_IMAGE is the published fleet runtime.
# GO_IMAGE digest is the bookworm image config (linux/amd64) as of sec-20260728-high.
# BASE_IMAGE index digest for multi-arch ubuntu:24.04 (Docker Hub, as of sec-20260728).
ARG GO_IMAGE=golang:1.26.5-bookworm@sha256:1ecb7edf62a0408027bd5729dfd6b1b8766e578e8df93995b225dfd0944eb651
ARG BASE_IMAGE=ubuntu:24.04@sha256:4fbb8e6a8395de5a7550b33509421a2bafbc0aab6c06ba2cef9ebffbc7092d90

FROM ${GO_IMAGE} AS go-tools

# Use the image's toolchain (1.26.5) rather than downloading go.mod toolchain.
ENV GOTOOLCHAIN=local \
    CGO_ENABLED=0 \
    GOPROXY=https://proxy.golang.org,direct

ARG GH_VERSION=2.96.0
ARG TRIVY_VERSION=0.72.0
# Module floors that clear fixable HIGH findings in the release binaries.
ARG GRPC_VERSION=v1.82.1
ARG ORAS_VERSION=v2.6.1

RUN set -eu; \
    mkdir -p /out; \
    git clone --depth 1 --branch "v${GH_VERSION}" https://github.com/cli/cli.git /src/cli; \
    cd /src/cli; \
    go get "google.golang.org/grpc@${GRPC_VERSION}"; \
    go mod tidy; \
    go build -trimpath \
      -ldflags "-s -w -X github.com/cli/cli/v2/internal/build.Version=v${GH_VERSION}-sec -X github.com/cli/cli/v2/internal/build.Date=2026-07-28" \
      -o /out/gh ./cmd/gh; \
    git clone --depth 1 --branch "v${TRIVY_VERSION}" https://github.com/aquasecurity/trivy.git /src/trivy; \
    cd /src/trivy; \
    go get "google.golang.org/grpc@${GRPC_VERSION}" "oras.land/oras-go/v2@${ORAS_VERSION}"; \
    go mod tidy; \
    GOEXPERIMENT=jsonv2 go build -trimpath \
      -ldflags "-s -w -extldflags '-static' -X github.com/aquasecurity/trivy/pkg/version/app.ver=${TRIVY_VERSION}-sec" \
      -o /out/trivy ./cmd/trivy; \
    /out/gh --version; \
    /out/trivy --version

# Final runtime image (fleet runner base). BASE_IMAGE ARG is declared globally above.
FROM ${BASE_IMAGE}

# NO `SHELL ["/bin/bash", "-o", "pipefail", "-c"]` HERE — it does not work, and
# the way it fails is worth writing down.
#
# podman/buildah builds OCI format by default, and OCI has no field for SHELL.
# The build does not stop; it prints
#
#     level=warning msg="SHELL is not supported for OCI image format,
#     [/bin/bash -o pipefail -c] will be ignored. Must use `docker` format"
#
# and carries on. Every RUN then executes under /bin/sh, which on Ubuntu is
# dash, and dash has no `-o pipefail`. The apt layer below has no pipefail so it
# succeeded; the build died four steps later on the gh layer with
#
#     /bin/sh: 1: set: Illegal option -o pipefail
#
# — a message pointing at the RUN rather than at the ignored SHELL four steps
# above it. A directive that is silently dropped and then surfaces as an
# unrelated error is the same shape as the rest of this fleet's gate problems.
#
# The fix is deliberately NOT `--format docker`. That would restore SHELL, but
# it makes this file's correctness depend on a flag passed from somewhere else,
# and pins the published image to Docker v2s2 for a build-time convenience.
#
# Instead every RUN below is correct under plain `sh`: `set -eu`, which dash
# supports, and no pipe whose middle exit status needs catching. See the two
# checksum steps for how the only real pipe was removed.

ARG DEBIAN_FRONTEND=noninteractive

# The tools fleet CI actually shells out to. Deliberately minimal: this is the
# layer every repo pays for.
#   git/curl/ca-certificates  checkout and every download step
#   jq                        every fleet script parses JSON with it
#   openssl                   RS256 JWT signing on the GitHub App token path
#   python3 + pyyaml          the SOPS-config editors parse YAML rather than
#                             string-munging it (a line-position assumption once
#                             broke every decrypt in the fleet)
#   shellcheck                reusable-ci-shell.yml FAILS rather than skipping
#                             when a requested tool is missing
#   age                       sops' encryption backend
#   gh / sops / trivy         gh+trivy from go-tools stage; sops release tarball
# apt-get upgrade applies current Ubuntu security patches for OS packages
# before the install set lands (sec-20260728 hardening pass).
RUN apt-get update -qq \
    && apt-get upgrade -y -qq \
    && apt-get install -y -qq --no-install-recommends \
        ca-certificates \
        curl \
        git \
        jq \
        openssl \
        python3 \
        python3-yaml \
        shellcheck \
        age \
        tar \
        gzip \
    && rm -rf /var/lib/apt/lists/*

# ── gh + trivy: rebuilt from release tags with HIGH-fixing go modules ────────
# See go-tools stage. Version labels carry a "-sec" suffix so `tool --version`
# shows this is not the stock upstream release binary.
COPY --from=go-tools /out/gh /usr/local/bin/gh
COPY --from=go-tools /out/trivy /usr/local/bin/trivy
RUN set -eu; \
    gh --version; \
    trivy --version

# ── sops: pinned and checksum-verified, matching setup-laptop.sh ──────────────
# Upstream release binary has 0 HIGH findings; keep the tarball install.
ARG SOPS_VERSION=3.13.3
RUN set -eu; \
    case "$(dpkg --print-architecture)" in \
      amd64) SARCH=amd64 ;; \
      arm64) SARCH=arm64 ;; \
      *) echo "unsupported architecture: $(dpkg --print-architecture)" >&2; exit 1 ;; \
    esac; \
    BIN="sops-v${SOPS_VERSION}.linux.${SARCH}"; \
    BASE="https://github.com/getsops/sops/releases/download/v${SOPS_VERSION}"; \
    cd /tmp; \
    curl -fsSL -o "$BIN" "${BASE}/${BIN}"; \
    curl -fsSL -o sums "${BASE}/sops-v${SOPS_VERSION}.checksums.txt"; \
    grep " ${BIN}\$" sums > expected.sha256; \
    sha256sum -c expected.sha256; \
    install -m 0755 "$BIN" /usr/local/bin/sops; \
    rm -rf /tmp/*; \
    sops --version

# Language toolchains (rustc, cargo, ruff, python venvs, go, …) belong in
# derived images that build FROM this base via the reusable workflow's
# base-image input — not here. This layer stays fleet-common and slow-moving.

# Prove the image is what it claims to be at BUILD time, so a broken layer fails
# here rather than in somebody's CI job an hour later. Missing tools exit 1.
RUN set -eu; \
    for t in git curl jq openssl python3 shellcheck age gh sops trivy; do \
      command -v "$t" >/dev/null || { echo "missing from image: $t" >&2; exit 1; }; \
    done; \
    python3 -c 'import yaml' || { echo "pyyaml missing from image" >&2; exit 1; }; \
    echo "runner-base: all expected tools present"

LABEL org.opencontainers.image.source="https://github.com/tzervas/ap-workflows" \
      org.opencontainers.image.description="Fleet runner base — carries the tools rootless jobs cannot install themselves" \
      org.opencontainers.image.licenses="MIT"
